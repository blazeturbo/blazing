//          ___          _                 __  _
//         /   |  ____  (_)___ ___  ____ _/ /_(_)___  ____
//        / /| | / __ \/ / __ `__ \/ __ `/ __/ / __ \/ __ \
//       / ___ |/ / / / / / / / / / /_/ / /_/ / /_/ / / / /
//      /_/  |_/_/ /_/_/_/ /_/ /_/\__,_/\__/_/\____/_/ /_/

// Frosted-glass open/close, take 3: pure blur + veil + fade, NO scale
// transform (scaling smears edge pixels). Soft 13-tap blur, gentle
// desaturating veil, full-length fade. ~250ms each.

animations {
    on
    slowdown 1.7

    //================================================================
    // Window Open: frosted glass resolves into clarity.
    window-open {
        duration-ms 150
        curve "ease-out-quad"
        custom-shader r"
            vec4 glass(vec3 g, vec2 px, float radius) {
                vec2 r = px * radius;
                vec2 r2 = r * 2.0;
                vec4 c = texture2D(niri_tex, (niri_geo_to_tex * g).st) * 5.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r.x, 0.0, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r.x, 0.0, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(0.0, r.y, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(0.0, r.y, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r.x, r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r.x, r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r.x, -r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r.x, -r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r2.x, 0.0, 0.0))).st) * 0.5;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r2.x, 0.0, 0.0))).st) * 0.5;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(0.0, r2.y, 0.0))).st) * 0.5;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(0.0, r2.y, 0.0))).st) * 0.5;
                return c / 19.0;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;

                vec2 px = vec2(1.0 / max(size_geo.x, 1.0), 1.0 / max(size_geo.y, 1.0));
                vec4 color = glass(coords_geo, px, (1.0 - p) * 9.0);

                float frost = 1.0 - p;
                float luma = dot(color.rgb, vec3(0.299, 0.587, 0.114));
                color.rgb = mix(color.rgb, vec3(luma), frost * 0.45);
                color.rgb = mix(color.rgb * 0.9, vec3(1.0), frost * 0.28 * color.a);

                color *= smoothstep(0.0, 1.0, p);

                return color;
            }
        "
    }

    //================================================================
    // Window Close: clarity sinks into frosted glass and shadow.
    window-close {
        duration-ms 150
        curve "ease-out-quad"
        custom-shader r"
            vec4 glass(vec3 g, vec2 px, float radius) {
                vec2 r = px * radius;
                vec2 r2 = r * 2.0;
                vec4 c = texture2D(niri_tex, (niri_geo_to_tex * g).st) * 5.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r.x, 0.0, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r.x, 0.0, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(0.0, r.y, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(0.0, r.y, 0.0))).st) * 2.0;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r.x, r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r.x, r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r.x, -r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r.x, -r.y, 0.0))).st);
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(r2.x, 0.0, 0.0))).st) * 0.5;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(r2.x, 0.0, 0.0))).st) * 0.5;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g + vec3(0.0, r2.y, 0.0))).st) * 0.5;
                c += texture2D(niri_tex, (niri_geo_to_tex * (g - vec3(0.0, r2.y, 0.0))).st) * 0.5;
                return c / 19.0;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;

                vec2 px = vec2(1.0 / max(size_geo.x, 1.0), 1.0 / max(size_geo.y, 1.0));
                vec4 color = glass(coords_geo, px, p * 9.0);

                float luma = dot(color.rgb, vec3(0.299, 0.587, 0.114));
                color.rgb = mix(color.rgb, vec3(luma), p * 0.45);
                color.rgb = mix(color.rgb * (1.0 - 0.3 * p), vec3(1.0), p * 0.28 * color.a);

                color *= 1.0 - smoothstep(0.0, 1.0, p);

                return color;
            }
        "
    }

    //================================================================
    // Animations for various window movements and transitions
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }

    workspace-switch {
        spring damping-ratio=1.2 stiffness=1000 epsilon=0.0001
    }
}
