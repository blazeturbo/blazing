// Niri Configuration
prefer-no-csd

// Monitor Output Settings (Samsung Odyssey G40B @ 240Hz / 239.76Hz)
// No variable-refresh-rate: HDMI can't do VRR, the flag was a no-op
// (niri msg outputs: "not supported"). If you ever move to DisplayPort,
// re-add `variable-refresh-rate` (or `on-demand=true`) to the DP-1 block.
output "HDMI-A-1" {
    mode "1920x1080@239.760"
}

output "DP-1" {
    mode "1920x1080@239.760"
}

include "autostart.kdl"
include "keybinds.kdl"
include "animations.kdl"
include "settings.kdl"
include "environment.kdl"
include "rules.kdl"

screenshot-path "~/Pictures/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png"
