// DO NOT EDIT THIS FILE, EDIT ~/hakucfg/wm/niri-custom.kdl INSTEAD

// Niri overview backdrop: blurred wallpaper, served by the "-backdrop"
// awww-daemon instance from autostart.kdl (layer namespace becomes
// "awww-daemon-backdrop"; verify with `niri msg layers`).
layer-rule {
    match namespace="awww-daemon-backdrop"
    place-within-backdrop true
}

// Rounded corners for all windows
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// No dimming for inactive windows: focused and unfocused look identical.
// (Focus behavior itself is untouched, this is purely cosmetic.)

// Background effect for all windows
window-rule {
    match app-id=r#".*"#

    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 2
    }
}

// Rules for Noctalia
window-rule {
    match app-id=r#"dev\.noctalia\.Noctalia"#
    open-floating true
}

// Rules for specific applications
window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    match app-id=r#"app.zen_browser.zen$"# title="^Picture-in-Picture$"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    
    open-floating true
}

window-rule {
    match app-id=r#"zen"#
    match app-id=r#"app.zen_browser.zen"#
    match app-id=r#"firefox"#
    match app-id=r#"code"#
    open-maximized true
}

window-rule {
    match app-id=r#"thunar"#
    default-column-width { proportion 0.65; }
}

// Rules for xdg-desktop-portal-gtk
window-rule {
    match app-id=r#"xdg-desktop-portal-gtk"#

    open-floating true
    default-floating-position x=0 y=0
    min-width 400
    min-height 600
}

// Rules for specific layers
layer-rule {
    match namespace="waybar"

    opacity 1.0
    shadow {
        on
        softness 100
        spread 12
        offset x=0 y=0
        draw-behind-window true
        color "#00000064"
    }
}

layer-rule {
    match namespace="rofi"

    opacity 0.9
    geometry-corner-radius 20
    background-effect {
        blur true
        xray false
        noise 0.3
        saturation 1.5
    }
    shadow {
        on
        softness 80
        spread 20
        offset x=0 y=0
        draw-behind-window true
        color "#00000064"
    }
}

// Rules for desktop icons
window-rule {
    match app-id="desktop_icons.py"
    match title="Rename"

    open-floating true
    min-width 300
    min-height 100
}

// Sober/Roblox: maximized from the first frame, no compositor eye-candy.
// Maximized gives the game one stable size from the first configure —
// tiling resize storms permanently invalidate Vulkan swapchains
// (VK_ERROR_OUT_OF_DATE_KHR loop, window never presents). Blur/xray off:
// per-frame compositor effects are pure GPU waste on a game.
// Shadows deliberately left alone.
window-rule {
    match app-id=r#"org\.vinegarhq\.Sober"#
    match title=r#"^Roblox$"#

    open-maximized true

    background-effect {
        xray false
        blur false
    }
}

// See-through Spotify and Equibop (0.8, like kitty). Per-app only on
// purpose: nothing global, Sober and everything else stay fully opaque.
window-rule {
    match app-id=r#"spotify"#
    match app-id=r#"equibop"#

    opacity 0.8
}